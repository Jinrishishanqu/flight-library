@{
  # 整合计划：每族一本。字段说明
  #   Dir          输出/主要工作目录（校对后文章\<Dir>）
  #   Dirs         可选，候选目录（相对项目根），默认 校对后文章\<Dir>
  #   Title        产物书名
  #   Mode         'Concat'（按章拼接）| 'KeepBest'（取最长，其余移入 归档\重复_根级）
  #   Include      文件名正则（去 .txt 后匹配）数组
  #   Exclude      排除正则数组
  #   HeadPattern  首行正则，进一步限定
  #   Base         已有合并件的文件名正则；会先按【第X回/章】切段再参与去重
  #   Span         固定 span 标记（不填则自动算 起~止 与缺章）
  #   NoChapter    忽略章号，全部按文件名顺序拼接

  Families = @(

    # ---------- 斗破：薰儿线回目连载（Base 14 章 + 散章补齐） ----------
    @{
      Dir         = '斗破'
      Title       = '斗破·薰儿线回目连载'
      Mode        = 'Concat'
      Include     = @('.*')
      Exclude     = @('~', '合集', '^《斗破·', '^《斗罗·', 'RPG')
      HeadPattern = '^【第[0-9一二三四五六七八九十百]+(?:回|章)[：:，,]'
      Base        = '^《斗破·薰儿线回目连载》'
    },

    # ---------- 斗破：夜玄线（合并件已含 7/10/11/17 章，散章为重复版本） ----------
    @{
      Dir     = '斗破'
      Title   = '斗罗·从斗罗开始收取性奴的诸天之旅'
      Mode    = 'KeepBest'
      Span    = '7~123'
      Include = @('^《斗罗·从斗罗开始收取性奴的诸天之旅》', '^《加列家族与奥巴家族的覆灭》', '^《启程，带着薰儿离开萧家》', '^《魔兽山脉外的惨剧', '^《蛇人女王美杜莎》')
    },

    # ---------- 斗破：沧破苍穹（两部同名取长） ----------
    @{
      Dir     = '斗破'
      Title   = '操破苍穹'
      Mode    = 'KeepBest'
      Include = @('^《1~12-操破苍穹》', '^《《操破苍穹1-12》》')
    },

    # ---------- 斗破：淫帝无双系列（5 个版本取最全） ----------
    @{
      Dir     = '斗破'
      Title   = '斗破苍穹之淫帝无双'
      Mode    = 'KeepBest'
      Include = @('淫帝无双', '银帝无双')
    },

    # ---------- 斗破：紫妍三份同文取长 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破之紫妍'
      Mode    = 'KeepBest'
      Include = @('^《斗破之紫妍》', '^《斗破之调教极品萝莉紫妍', '^《斗破苍穹成人系列 极品小萝莉紫研》')
    },

    # ---------- 斗破：柳席两版取长 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破之柳席'
      Mode    = 'KeepBest'
      Include = @('^《斗破之柳席')
    },

    # ---------- 斗破：tk 系列 8 篇合成合集 ----------
    @{
      Dir       = '斗破'
      Title     = '斗破tk系列'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('^《斗破 ?tk', '^《斗破tk')
    },

    # ---------- 斗破：绿文第三、四篇合成合集 ----------
    @{
      Dir       = '斗破'
      Title     = '斗破绿文'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('^《斗破绿文第三篇', '^《绿文第四篇')
    },

    # ---------- 斗破：古族女神萧薰的征程 1~3 + 4 ----------
    @{
      Dir     = '斗破'
      Title   = '古族女神萧薰的征程'
      Mode    = 'Concat'
      Include = @('^《1~3-古族女神萧薰的征程', '^《4-古族女神萧薰的征程')
    },

    # ---------- 斗破：改编版（米鼠）—— 已从第一版主抓到完整 6 章 6.9w，其余残页/分章版一并收掉 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破苍穹改编版'
      Mode    = 'KeepBest'
      Span    = '1~6章'
      Include = @('改编版')
    },

    # ---------- 斗破：萧薰儿的征程（脏名重复） ----------
    @{
      Dir     = '斗破'
      Title   = '斗破苍穹之萧薰儿的征程'
      Mode    = 'KeepBest'
      Include = @('^《斗破苍穹之萧薰儿的征程')
    },

    # ---------- 斗破：萧薰儿别传系列 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破之萧薰儿别传'
      Mode    = 'KeepBest'
      Include = @('^《萧熏儿别传》', '^《1~7斗破之萧薰儿别传')
    },

    # ---------- 斗破：花宗秘史 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破之花宗秘史'
      Mode    = 'KeepBest'
      Include = @('花宗秘史')
    },

    # ---------- 斗破：黑暗奴隶拍卖大会 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破苍穹·黑暗奴隶拍卖大会'
      Mode    = 'KeepBest'
      Include = @('黑暗奴隶拍卖大会')
    },

    # ---------- 斗破：淫传 ----------
    @{
      Dir     = '斗破'
      Title   = '斗破淫传'
      Mode    = 'KeepBest'
      Include = @('^《斗破淫传[》\(]')
    },

    # ---------- 斗破：美杜莎之辱 / 凌辱归途的女王（含添长版） ----------
    @{
      Dir     = '斗破'
      Title   = '斗破苍穹·凌辱归途的女王'
      Mode    = 'KeepBest'
      Include = @('美杜莎之辱', '凌辱归途的女王')
    },

    # ---------- 斗破：千年变（正文 + 前传合一本） ----------
    @{
      Dir       = '斗破'
      Title     = '斗破之千年变'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集（含前传）'
      Include   = @('^《斗破之千年变》', '^《斗破苍穹之千年变前传》')
    },

    # ---------- 斗破：纯爱短篇四则 ----------
    @{
      Dir       = '斗破'
      Title     = '斗破纯爱短篇'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('^《纯爱-', '^《斗破纯爱之萧炎与众女')
    },

    # ================= 斗罗 =================

    # ---------- 斗罗：斗罗1-乱舞 1+2 ----------
    @{
      Dir       = '斗罗'
      Title     = '斗罗1-乱舞'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('斗罗1-乱舞')
    },

    # ---------- 斗罗：绝世之大小七怪乱交 1+2 ----------
    @{
      Dir     = '斗罗'
      Title   = '斗罗绝世之大小七怪乱交'
      Mode    = 'Concat'
      Include = @('斗罗绝世之大小七怪乱交')
    },

    # ---------- 斗罗：金龙王之神界传说 1 + 2~3 ----------
    @{
      Dir     = '斗罗'
      Title   = '斗罗-金龙王之神界传说'
      Mode    = 'Concat'
      Include = @('斗罗-金龙王之神界传说')
    },

    # ---------- 斗罗：王喆干墨蓝丶古月丶叶星澜 1~3 + 王喆干娜儿 4 ----------
    @{
      Dir       = '斗罗'
      Title     = '王喆干墨蓝丶古月丶叶星澜与娜儿'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('^《1~3-王喆干墨蓝丶古月丶叶星澜', '^《4-王喆干娜儿')
    },

    # ---------- 斗罗：神界传说两个版本取长 ----------
    @{
      Dir     = '斗罗'
      Title   = '神界传说'
      Mode    = 'KeepBest'
      Include = @('^《神界传说》')
    },

    # ---------- 斗罗：凌辱冥想中的古月娜 正文 + 续 ----------
    @{
      Dir       = '斗罗'
      Title     = '凌辱冥想中的古月娜'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('凌辱冥想中的古月娜')
    },

    # ---------- 斗罗：媚药的叶星澜一行 正文 + 续 ----------
    @{
      Dir       = '斗罗'
      Title     = '中媚药的叶星澜一行'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('媚药的叶星澜一行')
    },

    # ---------- 斗罗：王喆神界怼众女 正文 + 续 ----------
    @{
      Dir       = '斗罗'
      Title     = '王喆神界怼众女'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('王喆神界怼众女')
    },

    # ---------- 斗罗：蓝木子与唐音梦 正文 + 续 ----------
    @{
      Dir       = '斗罗'
      Title     = '蓝木子与唐音梦'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('蓝木子与唐音梦')
    },

    # ---------- 斗罗：（加料）三卷与全本 —— 全本已含，取全本 ----------
    @{
      Dir     = '斗罗'
      Title   = '斗罗·（加料）全本'
      Mode    = 'KeepBest'
      Span    = '1~80（缺41-60章）'
      Include = @('^《（加料）第', '^《斗罗·（加料）全本》')
    },

    # ---------- 斗罗：戴华斌与王冬儿（标题不同、正文相同） ----------
    @{
      Dir     = '斗罗'
      Title   = '戴华斌与王冬儿'
      Mode    = 'KeepBest'
      Include = @('^《戴华斌与王冬儿》', '^《戴华斌干王冬儿')
    },

    # ---------- 斗罗：江楠楠（短版是长版的前段） ----------
    @{
      Dir     = '斗罗'
      Title   = '霍雨浩与江楠楠'
      Mode    = 'KeepBest'
      Include = @('^《江楠楠》-全篇', '^《霍雨浩与江楠楠-独立2篇')
    },

    # ---------- 斗罗：霍雨浩的邪恶主神（新绝世唐门h秋冬 是短版） ----------
    @{
      Dir     = '斗罗'
      Title   = '霍雨浩的邪恶主神'
      Mode    = 'KeepBest'
      Include = @('^《霍雨浩的邪恶主神', '^《新绝世唐门h秋冬》')
    },

    # ---------- 斗罗：斗1 短篇六则 ----------
    @{
      Dir       = '斗罗'
      Title     = '斗1短篇集'
      Mode      = 'Concat'
      NoChapter = $true
      Span      = '合集'
      Include   = @('^《斗1')
    }
  )
}
