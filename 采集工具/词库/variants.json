{
  "_comment": "打码/变形模式清单，机器可读。所有正则在 Python re 下使用，含 flags。replace 为 null 表示需要回调函数处理。",
  "_version": "2026-11-15",
  "masks": [
    {
      "name": "star_mask",
      "desc": "汉字间夹星号打码，如 白衣**、三个**唐三",
      "pattern": "(?<=[\\u4e00-\\u9fff])[*＊]{1,6}(?=[\\u4e00-\\u9fff])",
      "replace": "",
      "note": "长串 ＊＊＊ 是章节分隔线，需先由 sep 规则处理"
    },
    {
      "name": "hash_mask",
      "desc": "汉字间夹井号打码，如 乳#头、骚#货、跳#蛋",
      "pattern": "(?<=[\\u4e00-\\u9fff])[#＃](?=[\\u4e00-\\u9fff])",
      "replace": "",
      "note": "# 不是中文标点，可盲删"
    },
    {
      "name": "tick_mask",
      "desc": "汉字间夹反引号/单引号/脱字符打码，如 爱`液、小'穴、高^潮",
      "pattern": "(?<=[\\u4e00-\\u9fff])[`'^](?=[\\u4e00-\\u9fff])",
      "replace": ""
    },
    {
      "name": "bslash_mask",
      "desc": "反斜杠当打码/强调号，如 黒\\擎、爱\\液",
      "pattern": "(?<![A-Za-z0-9:/\\\\])\\\\(?![A-Za-z0-9:/\\\\])",
      "replace": "",
      "note": "保留 URL/路径语境"
    },
    {
      "name": "box_mask",
      "desc": "方框占位符",
      "pattern": "[囗□]",
      "replace": "口",
      "note": "口口 多数是正常词（咽了口口水/口口声声），只有 囗/□ 是真打码"
    },
    {
      "name": "gap_any",
      "desc": "词内插任意非汉字（1-3 字符），需配合词表使用",
      "pattern": "[^\\u4e00-\\u9fff\\r\\n]{1,3}",
      "replace": null,
      "note": "由 sex_terms 词表逐字 join 生成，见 lib.py build_gap_regex()"
    },
    {
      "name": "gap_hard",
      "desc": "词内插符号（强制还原），排除中文标点与省略号",
      "pattern": "[#＊*\\-–—―~～`'·^！？]{1,3}",
      "replace": null,
      "note": "浪叫拖音 肉……棒 不算打码，不还原"
    },
    {
      "name": "punct_gap",
      "desc": "词内插中文标点（春，药 / 足#交 / 屁～眼）",
      "pattern": "(?:(?![…])[^\\u4e00-\\u9fff\\r\\n]){1,3}",
      "replace": null
    },
    {
      "name": "split_comma",
      "desc": "两字词被逗号/顿号切开（私，处 / 赤，裸）",
      "pattern": "[，、]",
      "replace": null,
      "note": "必须白名单 + 上下文核对，统计法已证不可用"
    }
  ],
  "self_censor_pinyin": [
    {"token": "Rou", "restore": "肉", "count": 220, "example": "Rou棒→肉棒(211)"},
    {"token": "Gui", "restore": "龟", "count": 218, "example": "Gui头→龟头(213)"},
    {"token": "Jing", "restore": "精", "count": 102, "example": "Jing液→精液(97)"},
    {"token": "She", "restore": "射", "count": 30, "example": "She精→射精(28)"},
    {"token": "Nei", "restore": "内", "count": 1, "example": "Nei肉→内肉"},
    {"token": "Ru", "restore": "乳", "count": 1, "example": "Ru鸽→乳鸽"},
    {"token": "Ruan", "restore": "软", "count": 1, "example": "Ruan肉→软肉"},
    {"token": "ru", "restore": "乳", "count": 1, "example": "ru头→乳头"},
    {"token": "ShenYin", "restore": "呻吟", "count": 1},
    {"token": "Jian", "restore": "坚", "count": 3, "example": "Jian叫→坚叫"},
    {"token": "Di", "restore": "低", "count": 1, "example": "Di头→低头"},
    {"token": "ji", "restore": "鸡", "count": 2},
    {"token": "ye", "restore": "液", "count": 4},
    {"token": "jy", "restore": "精液", "count": 1},
    {"token": "MM", "restore": "妹妹", "count": 1},
    {"token": "pua", "restore": "PUA", "count": 1},
    {"token": "mi", "restore": "迷", "count": 1},
    {"token": "SM", "restore": "SM", "count": 1},
    {"token": "loli", "restore": "loli", "count": 2},
    {"token": "jk", "restore": "jk", "count": 2}
  ],
  "keep_as_style": [
    {"pattern": "肉……棒|精……液|骚……屄|花……穴|浪……叫", "reason": "浪叫拖音，作者刻意断字"},
    {"pattern": "好，好，好|你，你，你|啊，唔，啊", "reason": "口语重复与喘息"},
    {"pattern": "我，在，操，你", "reason": "原文『每插一次喊一个字』的笔法"},
    {"pattern": "？？？", "reason": "浪叫语气强调，不是乱码"}
  ]
}
